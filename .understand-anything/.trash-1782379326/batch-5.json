{
  "nodes": [
    {
      "id": "file:app/services/tremor.py",
      "type": "file",
      "name": "tremor.py",
      "filePath": "app/services/tremor.py",
      "summary": "librosa/scipy 기반으로 음성에서 떨림(tremor)과 안정적 발화 구간을 분석하는 서비스 모듈로, F0(피치)를 cents 단위로 추출하고 4~12Hz 대역의 떨림 에피소드를 검출하며 떨림이 없는 'good candidate' 발화 구간을 산출한다.",
      "tags": ["service", "audio-analysis", "tremor", "feature-extraction", "signal-processing"],
      "complexity": "complex",
      "languageNotes": "@dataclass로 설정/결과 구조체를 정의하고, librosa.yin·scipy.signal(butter/sosfiltfilt/medfilt)·numpy FFT를 조합한 DSP 파이프라인을 단일 TremorAnalyzer 클래스로 캡슐화한다."
    },
    {
      "id": "class:app/services/tremor.py:TremorConfig",
      "type": "class",
      "name": "TremorConfig",
      "filePath": "app/services/tremor.py",
      "lineRange": [11, 45],
      "summary": "tremor 분석에 쓰이는 모든 하이퍼파라미터(sample rate, F0 범위, tremor 대역, 윈도/홉 길이, 에피소드 병합 임계값 등)를 담는 dataclass 설정 구조체.",
      "tags": ["data-model", "config", "dataclass", "tremor"],
      "complexity": "simple"
    },
    {
      "id": "class:app/services/tremor.py:TremorResult",
      "type": "class",
      "name": "TremorResult",
      "filePath": "app/services/tremor.py",
      "lineRange": [49, 55],
      "summary": "tremor 분석 결과를 담는 dataclass로, 떨림 횟수·에피소드 구간·유성음 길이·지속 발화 길이·디버그 윈도·good candidate 구간을 보관한다.",
      "tags": ["data-model", "dataclass", "result", "tremor"],
      "complexity": "simple"
    },
    {
      "id": "class:app/services/tremor.py:TremorAnalyzer",
      "type": "class",
      "name": "TremorAnalyzer",
      "filePath": "app/services/tremor.py",
      "lineRange": [58, 270],
      "summary": "PCM 오디오를 입력받아 F0 추출, octave 보정, 지속 발화 마스킹, 떨림 대역 FFT 분석, 에피소드 그룹핑까지 수행하는 핵심 tremor 분석기 클래스.",
      "tags": ["service", "audio-analysis", "signal-processing", "tremor", "feature-extraction"],
      "complexity": "complex"
    },
    {
      "id": "function:app/services/tremor.py:_extract_f0_cents",
      "type": "function",
      "name": "_extract_f0_cents",
      "filePath": "app/services/tremor.py",
      "lineRange": [78, 94],
      "summary": "librosa.yin으로 F0를 추정하고 RMS 에너지로 유성음 구간을 판정한 뒤, octave 오류를 보정하고 median 필터를 거쳐 F0를 cents 단위로 변환한다.",
      "tags": ["feature-extraction", "pitch", "librosa", "audio-analysis"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/services/tremor.py:_sustained_mask",
      "type": "function",
      "name": "_sustained_mask",
      "filePath": "app/services/tremor.py",
      "lineRange": [110, 142],
      "summary": "유성음 프레임 마스크에서 최소 지속 길이와 허용 갭을 기준으로 안정적으로 지속된 발화 구간만 남기는 부울 마스크를 생성한다.",
      "tags": ["signal-processing", "masking", "audio-analysis", "tremor"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/services/tremor.py:_speaking_spans",
      "type": "function",
      "name": "_speaking_spans",
      "filePath": "app/services/tremor.py",
      "lineRange": [144, 167],
      "summary": "유성음 마스크를 시간 구간(span) 리스트로 변환하면서 짧은 무음 갭은 잇고 긴 무음은 구간을 분리해 발화 spans를 산출한다.",
      "tags": ["signal-processing", "segmentation", "audio-analysis", "tremor"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/services/tremor.py:_subtract",
      "type": "function",
      "name": "_subtract",
      "filePath": "app/services/tremor.py",
      "lineRange": [174, 188],
      "summary": "발화 spans에서 떨림 에피소드 구간(holes)을 빼내어 떨림이 없는 good candidate 구간만 남기는 구간 차집합 연산을 수행한다.",
      "tags": ["utility", "interval-arithmetic", "tremor", "segmentation"],
      "complexity": "moderate"
    },
    {
      "id": "function:app/services/tremor.py:analyze",
      "type": "function",
      "name": "analyze",
      "filePath": "app/services/tremor.py",
      "lineRange": [192, 244],
      "summary": "PCM 입력에 대한 전체 tremor 분석 진입점으로, F0/지속 마스크 추출 후 윈도별 FFT로 떨림 대역 집중도를 계산하고 에피소드 그룹핑과 good candidate 산출까지 수행해 TremorResult를 반환한다.",
      "tags": ["entry-point", "audio-analysis", "tremor", "signal-processing", "feature-extraction"],
      "complexity": "complex"
    },
    {
      "id": "function:app/services/tremor.py:_group_episodes",
      "type": "function",
      "name": "_group_episodes",
